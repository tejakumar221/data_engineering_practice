{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "teja-adf-learning-2026"
		},
		"LS_ADLSGen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLSGen2'"
		},
		"LS_AzureBlobStorage_Student_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_AzureBlobStorage_Student'"
		},
		"LS_ADLSGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://tejaadls2026.dfs.core.windows.net/"
		},
		"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_fileName": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_folderPath": {
			"type": "string",
			"defaultValue": "@triggerBody().folderPath"
		},
		"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_TriggerStartTime": {
			"type": "string",
			"defaultValue": "@trigger().startTime"
		},
		"Employee_File_Event_Based_Trigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/f58bd998-d84a-4809-bbc2-b0ca707d258b/resourceGroups/adf-learning-rg/providers/Microsoft.Storage/storageAccounts/tejaadls2026"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "teja-adf-learning-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLSGen2_accountKey": {
						"value": "[parameters('LS_ADLSGen2_accountKey')]"
					},
					"LS_AzureBlobStorage_Student_connectionString": {
						"value": "[parameters('LS_AzureBlobStorage_Student_connectionString')]"
					},
					"LS_ADLSGen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_properties_typeProperties_url')]"
					},
					"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_fileName": {
						"value": "[parameters('Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_fileName')]"
					},
					"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_folderPath": {
						"value": "[parameters('Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_folderPath')]"
					},
					"Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_TriggerStartTime": {
						"value": "[parameters('Employee_File_Event_Based_Trigger_properties_Event_Trigger_Practice_Pipeline_parameters_TriggerStartTime')]"
					},
					"Employee_File_Event_Based_Trigger_properties_typeProperties_scope": {
						"value": "[parameters('Employee_File_Event_Based_Trigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "teja-adf-learning-2026_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'teja-adf-learning-2026_ArmTemplate_0')]"
			]
		}
	]
}